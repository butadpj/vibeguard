# Copy to .env in this vibeguard/ folder. Keep your real API key only in .env.
# Docker Compose and direct runner startup both read .env.
# Existing shell variables override .env; clear old exports before switching.
VIBEGUARD_DEMO_RUNTIME=1
VIBEGUARD_REPAIR_ENABLED=1

# STEP 4: choose openrouter for cloud testing, or ollama for local CPU repair.
# Cloud requires internet, paid credits, and OPENROUTER_API_KEY below.
VIBEGUARD_REPAIR_PROVIDER=openrouter
VIBEGUARD_CLOUD_MODEL=anthropic/claude-sonnet-5.5
OPENROUTER_API_KEY=

# LOCAL REPAIR: set VIBEGUARD_REPAIR_PROVIDER=ollama. No API key is needed.
# Download this model before offline work. Changing it requires requalification.
VIBEGUARD_LOCAL_MODEL=qwen2.5-coder:7b
# Absolute model-only folder on the Docker host; change if installed elsewhere.
VIBEGUARD_MODELS_DIRECTORY=/usr/share/ollama/.ollama/models

# STEP 2: choose openrouter for cloud chat, or ollama for local chat independently.
# Cloud sends conversation messages and the current goal to OpenRouter using the same key.
VIBEGUARD_GOAL_PROVIDER=openrouter
# Optional separate cloud model; blank uses VIBEGUARD_CLOUD_MODEL.
VIBEGUARD_GOAL_CLOUD_MODEL=
# Local Step 2 model:
VIBEGUARD_GOAL_MODEL=qwen2.5-coder:7b
# Docker runner: reach Ollama on the host.
VIBEGUARD_OLLAMA_URL=http://host.docker.internal:11434
# Direct host runner: replace the URL above with http://127.0.0.1:11434.
