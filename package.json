{
  "name": "vibeguard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter @vibeguard/dashboard build && pnpm --filter @vibeguard/runner build",
    "start": "pnpm --filter @vibeguard/runner start",
    "typecheck": "pnpm -r --if-present typecheck",
    "check": "pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.0.0"
  }
}
